# Discord
DISCORD_TOKEN=
DISCORD_NEWS_CHANNEL_ID=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_TRAILER_CHANNEL_ID=

# Hot-post source. "devvit" (recommended): payloads from the bc-bulletin Devvit app
# (devvit/), read from the private #bc-ingest channel -- the bot needs the Message
# Content intent and read access to that channel. "rss": Reddit's public RSS feeds
# (deprecated; still the automatic fallback when no fresh payload exists).
REDDIT_SOURCE=devvit
DISCORD_INGEST_CHANNEL_ID=
# INGEST_MAX_AGE_HOURS=6
# INGEST_FALLBACK_TO_RSS=true
# Run each bot cycle this many minutes after the Devvit ingest slot (UTC
# 00/04/08/12/16/20), so posts go out ~5 min after a fresh payload lands.
# INGEST_CYCLE_MINUTE_OFFSET=5

# Score rules (devvit source only; RSS has no scores)
# MIN_SCORE=10
# RANK_BY_SCORE=true
# POPULAR_SCORE=1000

# User-Agent for Reddit RSS (fallback) and Discord REST requests
REDDIT_USER_AGENT=bc-gaming-bot/1.0

# Optional overrides
# SUBREDDITS=Games,gaming,GamingLeaksAndRumours
# SUBREDDIT_WEIGHTS=gaming:3,Games:1.5,GamingLeaksAndRumours:1
# RSS_FEEDS=https://www.ign.com/rss/articles/feed?tags=games,https://www.polygon.com/rss/gaming/index.xml,https://www.pcgamer.com/rss/,https://www.eurogamer.net/feed,https://www.gamespot.com/feeds/game-news,https://www.vg247.com/feed,https://www.rockpapershotgun.com/feed,https://www.pcgamesn.com/feed
# CHECK_INTERVAL_HOURS=4
# RETENTION_DAYS=30
# POSTS_PER_CYCLE=5
# DB_PATH=bc_bot.db
